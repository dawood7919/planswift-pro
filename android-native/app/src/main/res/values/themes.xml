<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      System chrome matches the dark canvas-first design tokens, so the status and
      navigation bars do not frame the app in a colour it never uses.
    -->
    <style name="Theme.TakeoffNative" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FF8A3D</item>
        <item name="android:colorBackground">#0B0E11</item>
        <item name="android:statusBarColor">#14181D</item>
        <item name="android:navigationBarColor">#0B0E11</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
